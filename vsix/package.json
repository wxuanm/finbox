{
  "name": "finbox",
  "displayName": "FinBox",
  "description": "Monitor mutual fund estimates, fund trends, and A-share stock quotes inside VS Code.",
  "version": "0.1.0",
  "publisher": "finx",
  "icon": "media/extension-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wxuanm/finbox.git",
    "directory": "vsix"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:finbox.fund",
    "onView:finbox.stock",
    "onView:finbox.settings",
    "onCommand:finbox.open",
    "onCommand:finbox.fund.refresh",
    "onCommand:finbox.stock.refresh",
    "onCommand:finbox.fund.add",
    "onCommand:finbox.stock.add",
    "onCommand:finbox.fund.addToGroup",
    "onCommand:finbox.fund.createGroup",
    "onCommand:finbox.fund.renameGroup",
    "onCommand:finbox.fund.deleteGroup",
    "onCommand:finbox.fund.remove",
    "onCommand:finbox.stock.remove",
    "onCommand:finbox.stock.moveUp",
    "onCommand:finbox.stock.moveDown",
    "onCommand:finbox.stock.openTrend",
    "onCommand:finbox.settings.open",
    "onCommand:finbox.fund.openTrend",
    "onCommand:finbox.fund.openGroupTrend"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "finbox",
          "title": "FINBOX",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "finbox": [
        {
          "id": "finbox.fund",
          "name": "FUND"
        },
        {
          "id": "finbox.stock",
          "name": "STOCK"
        },
        {
          "id": "finbox.settings",
          "name": "SETTINGS"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "finbox.fund.refresh",
          "when": "view == finbox.fund",
          "group": "navigation@1"
        },
        {
          "command": "finbox.fund.createGroup",
          "when": "view == finbox.fund",
          "group": "navigation@2"
        },
        {
          "command": "finbox.stock.refresh",
          "when": "view == finbox.stock",
          "group": "navigation@1"
        },
        {
          "command": "finbox.stock.add",
          "when": "view == finbox.stock",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "finbox.fund.openTrend",
          "when": "view == finbox.fund && viewItem == fund",
          "group": "1_fund@1"
        },
        {
          "command": "finbox.fund.remove",
          "when": "view == finbox.fund && viewItem == fund",
          "group": "1_fund@2"
        },
        {
          "command": "finbox.fund.addToGroup",
          "when": "view == finbox.fund && viewItem == group",
          "group": "inline@1"
        },
        {
          "command": "finbox.fund.openGroupTrend",
          "when": "view == finbox.fund && viewItem == group",
          "group": "inline@2"
        },
        {
          "command": "finbox.fund.addToGroup",
          "when": "view == finbox.fund && viewItem == groupCustom",
          "group": "inline@1"
        },
        {
          "command": "finbox.fund.openGroupTrend",
          "when": "view == finbox.fund && viewItem == groupCustom",
          "group": "inline@2"
        },
        {
          "command": "finbox.fund.renameGroup",
          "when": "view == finbox.fund && viewItem == groupCustom",
          "group": "navigation@1"
        },
        {
          "command": "finbox.fund.deleteGroup",
          "when": "view == finbox.fund && viewItem == groupCustom",
          "group": "navigation@2"
        },
        {
          "command": "finbox.stock.remove",
          "when": "view == finbox.stock && viewItem == stock",
          "group": "9_stock@1"
        },
        {
          "command": "finbox.stock.moveUp",
          "when": "view == finbox.stock && viewItem == stock",
          "group": "1_stock@1"
        },
        {
          "command": "finbox.stock.moveDown",
          "when": "view == finbox.stock && viewItem == stock",
          "group": "1_stock@2"
        }
      ]
    },
    "commands": [
      {
        "command": "finbox.open",
        "title": "打开监控",
        "icon": "$(graph-line)"
      },
      {
        "command": "finbox.fund.refresh",
        "title": "刷新基金",
        "icon": "$(refresh)"
      },
      {
        "command": "finbox.stock.refresh",
        "title": "刷新股票",
        "icon": "$(refresh)"
      },
      {
        "command": "finbox.fund.add",
        "title": "添加基金",
        "icon": "$(add)"
      },
      {
        "command": "finbox.stock.add",
        "title": "添加股票",
        "icon": "$(add)"
      },
      {
        "command": "finbox.fund.addToGroup",
        "title": "添加基金",
        "icon": "$(add)"
      },
      {
        "command": "finbox.fund.createGroup",
        "title": "新建分组",
        "icon": "$(new-folder)"
      },
      {
        "command": "finbox.fund.renameGroup",
        "title": "修改名称",
        "icon": "$(edit)"
      },
      {
        "command": "finbox.fund.deleteGroup",
        "title": "删除分组",
        "icon": "$(trash)"
      },
      {
        "command": "finbox.fund.remove",
        "title": "移除基金",
        "icon": "$(close)"
      },
      {
        "command": "finbox.stock.remove",
        "title": "移除股票",
        "icon": "$(close)"
      },
      {
        "command": "finbox.stock.moveUp",
        "title": "上移股票",
        "icon": "$(arrow-up)"
      },
      {
        "command": "finbox.stock.moveDown",
        "title": "下移股票",
        "icon": "$(arrow-down)"
      },
      {
        "command": "finbox.stock.openTrend",
        "title": "股票实时走势",
        "icon": "$(graph-line)"
      },
      {
        "command": "finbox.fund.openTrend",
        "title": "基金走势",
        "icon": "$(graph-line)"
      },
      {
        "command": "finbox.fund.openGroupTrend",
        "title": "分组趋势",
        "icon": "$(pulse)"
      },
      {
        "command": "finbox.settings.open",
        "title": "打开 FinBox 设置",
        "icon": "$(settings-gear)"
      }
    ],
    "configuration": {
      "title": "FinBox",
      "properties": {
        "finbox.stock.autoRefresh.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic A-share stock quote refresh."
        },
        "finbox.stock.autoRefresh.intervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Automatic stock quote refresh interval in minutes."
        },
        "finbox.stock.autoRefresh.tradingHoursOnly": {
          "type": "boolean",
          "default": true,
          "description": "Only refresh stock quotes automatically during weekday A-share market windows: 09:25-11:35 and 12:55-15:05 local time."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.92.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "echarts": "^5.6.0"
  }
}
